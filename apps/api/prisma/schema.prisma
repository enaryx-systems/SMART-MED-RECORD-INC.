generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgKind {
  INTERNAL
  CLIENT_FIRM
}

enum Role {
  CLIENT
  ADMIN
  REVIEWER
  BILLING
}

enum CaseStatus {
  DRAFT
  NEW
  IN_PROGRESS
  ON_HOLD
  AWAITING_DELIVERY
  DELIVERED
  CANCELED
}

enum CaseType {
  PERSONAL_INJURY
  MEDICAL_MALPRACTICE
  MASS_TORT_CLASS_ACTION
  SSD_CLAIMS
  NURSING_HOME
  SEXUAL_ABUSE_CASES
  WORKERS_COMPENSATION
  OTHER
}

enum DeliverySpeed {
  STANDARD
  EXPEDITED
}

enum DocumentKind {
  CLIENT_UPLOAD
  DELIVERABLE
}

enum CaseEventType {
  NOTE
  STATUS_CHANGE
  ASSIGNMENT
  DOCUMENT_UPLOADED
  INVOICE_ISSUED
  INVOICE_PAID
  INVOICE_UPDATED
}

enum InvoiceStatus {
  PENDING
  PAID
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  kind      OrgKind   @default(CLIENT_FIRM)
  createdAt DateTime  @default(now())
  users     User[]
  cases     Case[]
  invoices  Invoice[]
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String
  name              String
  role              Role       @default(CLIENT)
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cases             Case[]     @relation("CaseOwner")
  assignedCases     Case[]     @relation("CaseReviewer")
  uploadedDocuments Document[]
  caseEvents        CaseEvent[]
}

model Case {
  id                  String        @id @default(cuid())
  caseNumber          String        @unique
  matterName          String
  caseType            CaseType
  attorneyName        String?
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  caseOverview        String?       @db.Text
  caseIssues          String?       @db.Text
  specificInstructions String?      @db.Text
  servicesDesired     String[]      @default([])
  additionalServices  String[]      @default([])
  otherServicesNote   String?       @db.Text
  deliverySpeed       DeliverySpeed @default(STANDARD)
  pdfReference        Boolean       @default(false)
  batesReference      Boolean       @default(false)
  status              CaseStatus    @default(DRAFT)
  dueAt               DateTime?
  submittedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId             String
  owner               User          @relation("CaseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assignedReviewerId  String?
  assignedReviewer    User?         @relation("CaseReviewer", fields: [assignedReviewerId], references: [id])
  documents           Document[]
  events              CaseEvent[]
  invoiceLineItem     InvoiceLineItem?
}

model Document {
  id           String       @id @default(cuid())
  caseId       String
  case         Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fileName     String
  storageKey   String
  mimeType     String
  size         Int
  kind         DocumentKind @default(CLIENT_UPLOAD)
  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())
}

model CaseEvent {
  id        String        @id @default(cuid())
  caseId    String
  case      Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  type      CaseEventType
  body      String?       @db.Text
  createdAt DateTime      @default(now())
}

model Invoice {
  id             String            @id @default(cuid())
  number         String            @unique
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amountCents    Int
  status         InvoiceStatus     @default(PENDING)
  dueAt          DateTime
  paidAt         DateTime?
  createdAt      DateTime          @default(now())
  lineItems      InvoiceLineItem[]
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  caseId      String  @unique
  case        Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  description String
  amountCents Int
}

model CaseNumberSequence {
  id    Int @id @default(1)
  value Int @default(0)
}

model InvoiceNumberSequence {
  id    Int @id @default(1)
  value Int @default(0)
}
