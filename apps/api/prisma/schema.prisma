generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role and CaseStatus are plain strings rather than native Postgres enums so
// the schema stays portable across providers. Valid values are enforced in
// the application layer (see src/common/constants.ts).

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String
  firm         String?
  createdAt    DateTime @default(now())

  createdCases  Case[]     @relation("CreatorCases")
  assignedCases Case[]     @relation("AssigneeCases")
  reviewedCases Case[]     @relation("ReviewerCases")
  auditedCases  Case[]     @relation("QcCases")
  documents     Document[]
  messages      Message[]
  auditLogs     AuditLog[]
}

model Case {
  id           String    @id @default(cuid())
  caseNumber   String    @unique
  clientName   String
  matterName   String
  matterNumber String?
  claimNumber  String?
  service      String
  status       String    @default("AWAITING_APPROVAL")
  priority     String    @default("STANDARD")
  instructions String?
  pages        Int       @default(0)
  onHold       Boolean   @default(false)
  dueAt        DateTime?
  approvedAt   DateTime?
  assignedAt   DateTime?
  acknowledgedAt DateTime?
  deliveredAt  DateTime?
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  creatorId String
  creator   User   @relation("CreatorCases", fields: [creatorId], references: [id])

  approvedById String?

  assigneeId String?
  assignee   User?   @relation("AssigneeCases", fields: [assigneeId], references: [id])

  reviewerId String?
  reviewer   User?   @relation("ReviewerCases", fields: [reviewerId], references: [id])

  qcById String?
  qcBy   User?   @relation("QcCases", fields: [qcById], references: [id])

  documents Document[]
  messages  Message[]
  invoices  Invoice[]
  auditLogs AuditLog[]
}

model Document {
  id           String   @id @default(cuid())
  name         String
  storageKey   String
  mimeType     String
  size         Int
  category     String   @default("OTHER")
  createdAt    DateTime @default(now())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])
}

model Message {
  id         String   @id @default(cuid())
  body       String
  visibility String   @default("CLIENT")
  createdAt  DateTime @default(now())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Invoice {
  id          String    @id @default(cuid())
  number      String    @unique
  amountCents Int
  status      String    @default("PENDING")
  dueAt       DateTime
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])
}
