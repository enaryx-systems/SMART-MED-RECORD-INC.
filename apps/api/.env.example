PORT=4000
DATABASE_URL="postgresql://smartmed:smartmed@localhost:5432/smartmed?schema=public"
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
# Directory where uploaded case documents are stored locally (defaults to
# apps/api/uploads if unset). Only used when S3_BUCKET below is not set.
UPLOAD_ROOT=

# Object storage for case documents — required in production (a container's
# local disk is not guaranteed to survive a restart/redeploy on most hosts).
# Leave all of these unset to keep using local disk (fine for local dev only).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
