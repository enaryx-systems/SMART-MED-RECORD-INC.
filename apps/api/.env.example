PORT=4000
DATABASE_URL="postgresql://smartmed:smartmed@localhost:5432/smartmed?schema=public"
FRONTEND_URL=http://localhost:3000
# Directory where uploaded case documents are stored locally (defaults to
# apps/api/uploads if unset). Only used when S3_BUCKET below is not set.
UPLOAD_ROOT=

# Object storage for case documents — required in production (a container's
# local disk is not guaranteed to survive a restart/redeploy on most hosts).
# Leave all of these unset to keep using local disk (fine for local dev only).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Background jobs (BullMQ). Redis is provisioned locally via docker-compose
# (redis service).
REDIS_URL=redis://localhost:6379

# Vector DB for AI semantic search. Local dev: the docker-compose `qdrant`
# service (no key needed). Production: point at Qdrant Cloud instead.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# AI extraction/summary/search — every AI endpoint returns a clear 503 until
# this is set. Get a key at https://platform.openai.com.
OPENAI_API_KEY=

# Outbound email (case/invoice/welcome notifications). Left unset, the email
# service logs instead of sending — nothing breaks without a key.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Error monitoring. Left unset, Sentry's SDK no-ops by design.
SENTRY_DSN=

# Identity provider — user login/session verification. Get a key at
# https://dashboard.clerk.com (Secret Key, not the publishable one).
CLERK_SECRET_KEY=
