NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Real-time updates (Socket.IO) — the API server's own URL, not the /api path.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Identity provider — get keys at https://dashboard.clerk.com. Both are
# needed here: the publishable key for the browser, and the secret key
# because clerkMiddleware() (middleware.ts) runs server-side too. Use the
# same secret key value as apps/api's CLERK_SECRET_KEY.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Error monitoring. Left unset, Sentry's SDK no-ops by design.
NEXT_PUBLIC_SENTRY_DSN=
